TELEGRAM_TOKEN=your_bot_token_here

# Optional: Whisper model, see README for RAM usage. small | medium (default) | large-v3-turbo | large-v3
# WHISPER_MODEL=medium

# Optional: languages always offered by the Retry button, besides the ones Whisper detected.
# RETRY_LANGUAGES=ru,en

# Optional: path to the SQLite database used to persist /pause state across restarts.
# KHARON_DB_PATH=kharon.db